PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/strathkonnekt?schema=public"
CLIENT_URL="http://localhost:5173"

# Firebase Admin SDK (service account) - required for verifying Email OTP auth tokens
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gmail SMTP used to deliver sign-in links ourselves (bypasses Firebase's own
# email-sign-in quota). EMAIL_APP_PASSWORD must be a Gmail "App Password", not
# your real account password: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_APP_PASSWORD=
